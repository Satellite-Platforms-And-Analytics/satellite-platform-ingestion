# Satellite Platform — Ingestion Pipeline
# Copy to .env and fill in your values. Never commit .env to git
# (.gitignore's `.env*` + `!.env.example` pair handles that).
#
# ── How this file is kept honest ──────────────────────────────────────────────
# Rebuilt 2026-09-20 from `python prune_env.py --env .env.example`, which
# reports three things: keys nothing reads, keys mentioned but never read,
# and — the one that matters here — variables the CODE reads that this file
# never named. The version before this rebuild was 4 of 17 correct and
# missing 19. The worst of it was silent: this file said SPACETRACK_USER
# while config.py read SPACETRACK_USERNAME, and os.environ.get() returns
# None rather than raising, so following this file produced a Space-Track
# *authentication* failure. You would debug the password.
#
# Re-run the scanner after adding or removing any os.environ call:
#
#     python prune_env.py --env .env.example
#
# ── Defaults and what they assume ─────────────────────────────────────────────
# Variables marked "default:" are optional — the code falls back. But every
# path default below is an absolute D:\ or C:\ path from the machine this
# was built on. They are correct on `trazer` and wrong everywhere else, so
# on any other machine treat the optional paths as required.


# ══ Required ══════════════════════════════════════════════════════════════════

# PostgreSQL (Supabase). Read in 13+ modules — nothing runs without it.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Where the consolidated Space-Track caches and the request ledger live.
# REQUIRED, and deliberately un-defaulted in two different ways:
# check_ledger.py calls sys.exit() when it is unset, and config.py prints a
# banner and falls back to <repo>/data.
#
# The cost of getting this wrong is not a crash. A wrong directory means a
# second empty request ledger for one account and an empty gp_history
# cache — and an empty cache says "no object has been retrieved", which
# invites re-requesting histories already spent under Space-Track's
# once-per-object-per-lifetime rule. That budget is not refundable.
#
# On this machine the consolidated caches are at D:\Projects\Data\TLEs.
TLE_DATA_DIR=

# NASA TechPort, via api.nasa.gov.
# Free, email only, from https://api.nasa.gov — 1,000 requests/hour, and the
# response carries X-RateLimit-Remaining so the client can stop before the
# ceiling rather than discover it.
#
# Use the keyed api.nasa.gov route, NOT techport.nasa.gov directly. The direct
# host needs no key and publishes no rate limit, which is the dangerous one:
# you find an unpublished ceiling by hitting it (AD-060).
NASA_API_KEY=


# ══ Frontend (satellite-platform-frontend) ════════════════════════════════════
# Read by the Next.js route handlers. The anon key is the RLS-respecting
# one and is the only Supabase key that belongs in this file at all.
#
# On 2026-09-20 SUPABASE_SERVICE_KEY and SUPABASE_SECRET_KEY were deleted
# from .env — both bypass RLS, and nothing read either of them. Do not
# reintroduce them here. Writes go through the `pipeline` role
# (see satellite-platform-infrastructure/docs/PIPELINE_ROLE.md), which has
# explicit grants and a policy per table instead of a key that skips both.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=


# ══ Optional APIs ═════════════════════════════════════════════════════════════

# Space-Track. Optional: CelesTrak is the primary TLE source and needs no
# account. Set both or neither.
#
# NOTE the names. USERNAME and PASSWORD, not USER and PASS — config.py
# reads os.environ.get("SPACETRACK_USERNAME"), which yields None for a
# near-miss rather than complaining.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# N2YO, used only by src/tracking/compare_n2yo.py to cross-check our
# propagated positions against a third party. Unset simply disables that
# comparison.
N2YO_API_KEY=

# Who to contact about our requests. Optional, and NOT committed — the
# address is yours to publish, not the repository's. When set, it goes into
# the User-Agent every HTTP client sends:
#
#   satellite-platform/1.0 (technology readiness survey; <=1000 req/hr;
#                           contact you@example.com)
#
# Worth setting. An operator who can email you does not have to block you.
#
# The header itself is not optional and is not cosmetic. On 2026-09-14 the
# TechPort survey lost a day to a 403 that was never about the key:
# api.nasa.gov's WAF refuses `python-requests/<version>` before api.data.gov
# checks the key at all, so the body came back as an Apache HTML page that
# reads exactly like an authentication failure. One header: 403 → 200.
CONTACT_EMAIL=


# ══ Local paths ═══════════════════════════════════════════════════════════════
# All optional, all defaulting to this machine's D:\ layout. See the note at
# the top: on any other machine, set them.

# Sentinel-2 scenes: staging/, raw/, processed/   default: D:\SatelliteData
SATELLITE_DATA_DIR=D:/SatelliteData

# SQLite DB, the CelesTrak fetch log, the imagery CSV log
#                                                default: D:\Databases\satellite
SATELLITE_DB_DIR=D:/Databases/satellite

# archive_to_local.py --archive-dir, and archive_daily.cmd
#                                        default: D:\Databases\satellite\archive
SATELLITE_ARCHIVE_DIR=D:/Databases/satellite/archive

# WIT taxonomy data                                   default: D:\Databases\wit
WIT_BASE_DIR=D:/Databases/wit

# The WIT source checkout (AD-015: `pip install -e D:\Projects\WIT`)
#                                                      default: D:\Projects\WIT
WIT_PATH=D:/Projects/WIT


# ══ Seed inputs ═══════════════════════════════════════════════════════════════
# Each backs a --flag; the variable only changes that flag's default.

# seed_gcat.py --currentcat.  Default is an absolute OneDrive path on this
# machine, so this one is effectively required elsewhere.
GCAT_CURRENTCAT=

# seed_organizations.py --orgs             default: data/seed/orgs.tsv
GCAT_ORGS=

# seed_technologies.py --seed              default: data/seed/technologies.json
TECHNOLOGY_SEED=


# ══ Behaviour ═════════════════════════════════════════════════════════════════

# Python log level for src/db/writer.py             default: INFO
LOG_LEVEL=INFO

# Set to exactly "false" to bypass the spacetrack library and use the raw
# HTTP client. Any other value, including unset, leaves the library enabled.
USE_SPACETRACK_LIB=


# ══ Test gates ════════════════════════════════════════════════════════════════
# Not configuration — switches that turn skipped tests into real ones. Leave
# them unset here and set them per-run instead:
#
#   PowerShell:  $env:REQUIRE_DB=1; pytest tests/test_db_privileges.py -q
#   bash:        REQUIRE_DB=1 pytest tests/test_db_privileges.py -q
#
# ⚠ Each gate is read as bool(os.environ.get(...)), so ANY non-empty value
# is true — including "0" and "false". To turn one off, clear it; do not
# set it to 0.
#
# Left empty below rather than merely described in a comment, because an
# empty string is falsy — the gates stay off — and because a variable that
# exists only in prose reappears under ABSENT on every future scan, which
# trains you to skim past the section that is supposed to catch mistakes.

# Tests that need a live database
REQUIRE_DB=

# Migration idempotency tests. These APPLY SQL — not a read-only run.
# Point them at a scratch database, not production.
REQUIRE_SCHEMA=

# Tests that need the WIT package importable
REQUIRE_WIT=

# Override the schema file the migration tests read
# default: ../satellite-platform-infrastructure/schema/001_core_schema.sql
SCHEMA_SQL_PATH=


# ══ Deliberately absent ═══════════════════════════════════════════════════════
# Removed 2026-09-20 with evidence, so they do not creep back:
#
#   SUPABASE_SERVICE_KEY, SUPABASE_SECRET_KEY, SUPABASE_REST_URL,
#   SUPABASE_PUBLISHABLE_KEY  — unread; the first two bypass RLS
#   SPACETRACK_USER, SPACETRACK_PASS        — wrong names; see above
#   SQLITE_PATH, SATELLITE_DATA_BASE, GIS_DATA_BASE, MODELS_BASE,
#   TLE_REFRESH_HOURS, POSITION_UPDATE_MINUTES — never read by any code
#   CSV_LOG_PATH   — not a variable at all. It is a module constant in
#                    src/imagery/ingest.py derived from SATELLITE_DB_DIR.
#                    Setting it here would change nothing, which is worse
#                    than omitting it
#   QGIS_GDAL_TRANSLATE — never implemented. ingest.py globs
#                    C:\Program Files\QGIS*\bin\gdal_translate.exe instead
