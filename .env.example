# Satellite Platform — Ingestion Pipeline
# Copy to .env and fill in your values
# Never commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
# Phase 1: Supabase or Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/satellite_platform

# Local SQLite fallback (used until PostgreSQL is configured)
SQLITE_PATH=D:/Databases/satellite_platform.db

# ── Space-Track (optional — CelesTrak is primary) ─────────────────────────────
SPACETRACK_USER=your@email.com
SPACETRACK_PASS=yourpassword

# ── Copernicus / Sentinel-2 ───────────────────────────────────────────────────
COPERNICUS_USER=your@email.com
COPERNICUS_PASS=yourpassword

# ── NASA Earthdata ────────────────────────────────────────────────────────────
EARTHDATA_USER=yourusername
EARTHDATA_PASS=yourpassword

# ── QGIS (for JP2 conversion) ─────────────────────────────────────────────────
# Auto-detected from C:\Program Files\QGIS*\bin\gdal_translate.exe
# Override if QGIS is installed in a non-standard location
# QGIS_GDAL_TRANSLATE=C:\Program Files\QGIS 3.44.11\bin\gdal_translate.exe

# ── Local data paths ──────────────────────────────────────────────────────────
SATELLITE_DATA_BASE=D:/SatelliteData
GIS_DATA_BASE=D:/GIS
MODELS_BASE=D:/Models

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CSV_LOG_PATH=D:/Databases/ingestion_log.csv

# ── Scheduling ────────────────────────────────────────────────────────────────
TLE_REFRESH_HOURS=2
POSITION_UPDATE_MINUTES=5

# ── NASA TechPort (api.nasa.gov) ──────────────────────────────────────────────
# Free, email only, from https://api.nasa.gov — 1,000 requests/hour, and the
# response carries X-RateLimit-Remaining so the client can stop before the
# ceiling rather than discover it.
#
# Use the keyed api.nasa.gov route, NOT techport.nasa.gov directly. The direct
# host needs no key and publishes no rate limit, which is the dangerous one:
# you find an unpublished ceiling by hitting it (AD-060).
NASA_API_KEY=

# ── Who to contact about our requests ─────────────────────────────────────────
# Optional, and NOT committed — the address is yours to publish, not the
# repository's. When set, it goes into the User-Agent every HTTP client sends:
#
#   satellite-platform/1.0 (technology readiness survey; <=1000 req/hr;
#                           contact you@example.com)
#
# Worth setting. An operator who can email you does not have to block you.
#
# The header itself is not optional and is not cosmetic. On 2026-09-14 the
# TechPort survey lost a day to a 403 that was never about the key:
# api.nasa.gov's WAF refuses `python-requests/<version>` before api.data.gov
# checks the key at all, so the body came back as an Apache HTML page that
# reads exactly like an authentication failure. One header: 403 → 200.
CONTACT_EMAIL=
